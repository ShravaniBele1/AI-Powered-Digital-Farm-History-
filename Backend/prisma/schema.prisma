generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String       @db.VarChar(100)
  email         String       @unique @db.VarChar(255)
  password_hash String
  phone         String?      @db.VarChar(20)
  created_at    DateTime?    @default(now()) @db.Timestamp(6)
  updated_at    DateTime?    @default(now()) @db.Timestamp(6)
  ai_queries    ai_queries[]
  farms         farms[]
}

model farms {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String      @db.Uuid
  farm_name        String      @db.VarChar(150)
  village          String?     @db.VarChar(100)
  district         String?     @db.VarChar(100)
  state            String?     @db.VarChar(100)
  total_area_acres Decimal?    @db.Decimal(10, 2)
  created_at       DateTime?   @default(now()) @db.Timestamp(6)
  updated_at       DateTime?   @default(now()) @db.Timestamp(6)
  users            users       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  documents        documents[]
  fields           fields[]
  seasons          seasons[]
}

model fields {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farm_id         String        @db.Uuid
  field_name      String        @db.VarChar(100)
  area_acres      Decimal?      @db.Decimal(10, 2)
  soil_type       String?       @db.VarChar(100)
  irrigation_type String?       @db.VarChar(100)
  notes           String?
  created_at      DateTime?     @default(now()) @db.Timestamp(6)
  updated_at      DateTime?     @default(now()) @db.Timestamp(6)
  crop_cycles     crop_cycles[]
  documents       documents[]
  farms           farms         @relation(fields: [farm_id], references: [id], onDelete: Cascade)
}

model crops {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String        @unique @db.VarChar(100)
  category    String?       @db.VarChar(100)
  created_at  DateTime?     @default(now()) @db.Timestamp(6)
  crop_cycles crop_cycles[]
}

model seasons {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farm_id     String        @db.Uuid
  name        String        @db.VarChar(50)
  year        Int
  start_date  DateTime?     @db.Date
  end_date    DateTime?     @db.Date
  crop_cycles crop_cycles[]
  farms       farms         @relation(fields: [farm_id], references: [id], onDelete: Cascade)
}

model crop_cycles {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  field_id              String       @db.Uuid
  crop_id               String       @db.Uuid
  season_id             String       @db.Uuid
  variety               String?      @db.VarChar(100)
  sowing_date           DateTime?    @db.Date
  expected_harvest_date DateTime?    @db.Date
  actual_harvest_date   DateTime?    @db.Date
  status                String?      @db.VarChar(50)
  notes                 String?
  created_at            DateTime?    @default(now()) @db.Timestamp(6)
  updated_at            DateTime?    @default(now()) @db.Timestamp(6)
  activities            activities[]
  crops                 crops        @relation(fields: [crop_id], references: [id], onUpdate: NoAction)
  fields                fields       @relation(fields: [field_id], references: [id], onDelete: Cascade)
  seasons               seasons      @relation(fields: [season_id], references: [id], onDelete: Cascade)
  documents             documents[]
  expenses              expenses[]
  harvests              harvests[]
}

model activity_types {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String       @unique @db.VarChar(100)
  category   String?      @db.VarChar(100)
  created_at DateTime?    @default(now()) @db.Timestamp(6)
  activities activities[]
}

model activities {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  crop_cycle_id    String         @db.Uuid
  activity_type_id String         @db.Uuid
  activity_date    DateTime       @db.Date
  description      String?
  quantity         Decimal?       @db.Decimal(12, 2)
  unit             String?        @db.VarChar(30)
  cost             Decimal?       @db.Decimal(12, 2)
  notes            String?
  created_at       DateTime?      @default(now()) @db.Timestamp(6)
  updated_at       DateTime?      @default(now()) @db.Timestamp(6)
  activity_types   activity_types @relation(fields: [activity_type_id], references: [id], onUpdate: NoAction)
  crop_cycles      crop_cycles    @relation(fields: [crop_cycle_id], references: [id], onDelete: Cascade)
  ai_evidence      ai_evidence[]
  inputs           inputs[]
}

model inputs {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activity_id  String     @db.Uuid
  input_type   String     @db.VarChar(100)
  product_name String     @db.VarChar(150)
  quantity     Decimal?   @db.Decimal(12, 2)
  unit         String?    @db.VarChar(30)
  cost         Decimal?   @db.Decimal(12, 2)
  supplier     String?    @db.VarChar(150)
  notes        String?
  activities   activities @relation(fields: [activity_id], references: [id], onDelete: Cascade)
}

model expenses {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  crop_cycle_id  String      @db.Uuid
  expense_date   DateTime    @db.Date
  category       String      @db.VarChar(100)
  description    String?
  amount         Decimal     @db.Decimal(12, 2)
  payment_method String?     @db.VarChar(50)
  notes          String?
  created_at     DateTime?   @default(now()) @db.Timestamp(6)
  crop_cycles    crop_cycles @relation(fields: [crop_cycle_id], references: [id], onDelete: Cascade)
}

model harvests {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  crop_cycle_id String      @db.Uuid
  harvest_date  DateTime    @db.Date
  quantity      Decimal?    @db.Decimal(12, 2)
  unit          String?     @db.VarChar(30)
  quality_grade String?     @db.VarChar(50)
  selling_price Decimal?    @db.Decimal(12, 2)
  total_revenue Decimal?    @db.Decimal(12, 2)
  buyer         String?     @db.VarChar(150)
  notes         String?
  created_at    DateTime?   @default(now()) @db.Timestamp(6)
  crop_cycles   crop_cycles @relation(fields: [crop_cycle_id], references: [id], onDelete: Cascade)
}

model documents {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farm_id        String        @db.Uuid
  field_id       String?       @db.Uuid
  crop_cycle_id  String?       @db.Uuid
  document_type  String?       @db.VarChar(100)
  file_name      String        @db.VarChar(255)
  file_url       String
  extracted_text String?
  uploaded_at    DateTime?     @default(now()) @db.Timestamp(6)
  ai_evidence    ai_evidence[]
  crop_cycles    crop_cycles?  @relation(fields: [crop_cycle_id], references: [id])
  farms          farms         @relation(fields: [farm_id], references: [id], onDelete: Cascade)
  fields         fields?       @relation(fields: [field_id], references: [id])
}

model ai_queries {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String        @db.Uuid
  question    String
  answer      String?
  created_at  DateTime?     @default(now()) @db.Timestamp(6)
  ai_evidence ai_evidence[]
  users       users         @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model ai_evidence {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ai_query_id     String      @db.Uuid
  activity_id     String?     @db.Uuid
  document_id     String?     @db.Uuid
  relevance_score Decimal?    @db.Decimal(5, 4)
  activities      activities? @relation(fields: [activity_id], references: [id])
  ai_queries      ai_queries  @relation(fields: [ai_query_id], references: [id], onDelete: Cascade)
  documents       documents?  @relation(fields: [document_id], references: [id])
}
